# Tidbyt (required)
TIDBYT_DEVICE_ID=your-device-id-here
TIDBYT_API_TOKEN=your-tidbyt-api-token-here

# Location (required)
LAT=37.6213
LNG=-122.3790

# OpenSky (recommended)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# App
MODE=dashboard
RADIUS=20
INSTALLATION_ID=skytower

# Container
REFRESH_SECONDS=60
RUN_ONCE=0
