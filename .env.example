# Tidbyt credentials (required for push)
TIDBYT_DEVICE_ID=your-device-id-here
TIDBYT_API_TOKEN=your-api-token-here

# Observer location (required)
LAT=37.6213
LNG=-122.3790

# OpenSky OAuth credentials (optional but recommended)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# App configuration
MODE=dashboard
RADIUS=20
INSTALLATION_ID=skytower

# Container runtime
# RUN_ONCE=1           # set to run check/render/push once and exit
# REFRESH_SECONDS=60   # loop interval when RUN_ONCE is unset/0
